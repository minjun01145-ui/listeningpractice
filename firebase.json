{
  "hosting": [
    {
      "target": "listeningpractice",
      "public": ".",
      "cleanUrls": true,
      "headers": [
        {
          "source": "/teacher",
          "headers": [
            { "key": "Cache-Control", "value": "no-store, max-age=0" }
          ]
        },
        {
          "source": "/teacher.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-store, max-age=0" }
          ]
        }
      ],
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "**/.*",
        ".git/**",
        ".firebase/**",
        "**/.git/**",
        "**/.firebase/**",
        "**/node_modules/**",
        ".github/**",
        "README*",
        "lifecycle.json",
        "firestore.rules",
        "storage.rules"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
