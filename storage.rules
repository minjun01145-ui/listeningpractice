rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 학교 내부용 간단 MVP: 인증 없이 읽기/쓰기 허용.
    // 녹음/교사용 음원 최대 100MB로 제한하고 오디오 MIME만 허용합니다.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.resource == null ||
        (request.resource.size < 100 * 1024 * 1024 && request.resource.contentType.matches('audio/.*'));
    }
  }
}
