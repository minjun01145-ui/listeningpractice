rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 인증 도입 전 호환 규칙입니다. 경로/크기/MIME을 제한하지만 사용자를 식별하지는 못합니다.
    match /recordings/{studentNo}/{roundId}/{groupId}/{fileName} {
      allow read: if true;
      allow create, update: if request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if false;
    }

    match /teacher-audio/{roundId}/{fileName} {
      allow read: if true;
      allow create, update, delete: if request.resource == null ||
        (request.resource.size < 100 * 1024 * 1024
          && request.resource.contentType.matches('audio/.*'));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
